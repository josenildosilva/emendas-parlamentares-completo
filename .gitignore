# Segredos - NUNCA versionar
.env

# Ambiente virtual
.venv/
__pycache__/
*.pyc
*.pyo

# Dados (camadas raw e trusted podem ser grandes)
data/raw/*.json
data/trusted/
data/feat/
*.parquet
*.duckdb

# Manter estrutura de diretórios
!data/raw/.gitkeep
!data/trusted/.gitkeep
!data/mart/.gitkeep
!data/feat/.gitkeep

# Outputs de relatórios
reports/_site/
reports/*.html

# IDEs
.vscode/
.idea/
*.DS_Store

# Logs
logs/
*.log
