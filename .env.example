# Portal da Transparência - API Key (opcional)
# Sem ela o pipeline roda em modo demo, com a amostra versionada
# em data/raw/emendas_2023_sample.json.
# Obtenha em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
API_KEY=seu_token_aqui

# Anos a coletar, separados por vírgula (opcional - padrão: 2023)
# Ex.: ANOS=2022,2023,2024
# Pode ser sobrescrito na linha de comando: --anos 2022 2023
ANOS=2023

# Diretórios das camadas (opcional - padrões abaixo)
RAW_DIR=data/raw
TRUSTED_DIR=data/trusted
MART_DIR=data/mart
FEAT_DIR=data/feat
