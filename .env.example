# Portal da Transparência - API Key (obrigatório para ingestão via API)
# Obtenha em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
API_KEY=seu_token_aqui

# Configurações de ingestão (opcional - valores padrão abaixo)
ANO_INICIO=2023
ANO_FIM=2023

# Diretórios (opcional - padrão é data/)
RAW_DIR=data/raw
TRUSTED_DIR=data/trusted
MART_DIR=data/mart
FEAT_DIR=data/feat
